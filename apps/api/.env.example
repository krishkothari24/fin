# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (Supabase) ---
# Supabase Dashboard -> Connect. Prisma needs BOTH:
#   DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true  -> app queries
#   DIRECT_URL   = Direct connection  (port 5432)                    -> migrations
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
# Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret (used to verify user JWTs).
SUPABASE_JWT_SECRET=

# --- Plaid (Sandbox to start) ---
# Dashboard -> Team Settings -> Keys.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Public HTTPS URL Plaid posts webhooks to (use a tunnel in dev).
PLAID_WEBHOOK_URL=

# --- Encryption for Plaid access tokens at rest ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

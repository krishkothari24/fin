# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (Supabase) ---
# Supabase Dashboard -> Connect. Prisma needs BOTH:
#   DATABASE_URL = Transaction pooler (port 6543) + ?pgbouncer=true  -> app queries
#   DIRECT_URL   = Direct connection  (port 5432)                    -> migrations
DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Auth ---
# Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret (used to verify user JWTs).
SUPABASE_JWT_SECRET=

# --- Plaid (Sandbox to start) ---
# Dashboard -> Team Settings -> Keys.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Public HTTPS URL Plaid posts webhooks to (use a tunnel in dev).
PLAID_WEBHOOK_URL=

# --- Encryption for Plaid access tokens at rest ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Phase 6: hardening / prod readiness (all optional; sensible defaults) ---
# Error monitoring. Unset -> Sentry stays off. Sentry -> Project -> Client Keys (DSN).
SENTRY_DSN=
# Comma-separated browser origins allowed to call the API (the future web app).
# Unset -> CORS disabled (server-to-server only).
CORS_ORIGINS=
# Per-IP rate limit: RATE_LIMIT_LIMIT requests per RATE_LIMIT_TTL seconds.
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=120
# Hops to trust behind a proxy/LB (Render sets X-Forwarded-For). 0 = no proxy.
TRUST_PROXY=0
# Force JSON logs (true) or pretty lines (false). Unset -> JSON when NODE_ENV=production.
LOG_JSON=

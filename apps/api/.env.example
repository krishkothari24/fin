# Copy to .env and fill in. NEVER commit .env (it is gitignored).

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (Supabase Postgres connection string) ---
# Supabase: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# --- Supabase Auth ---
# Project Settings -> API.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret (used to verify user JWTs).
SUPABASE_JWT_SECRET=

# --- Plaid (Sandbox to start) ---
# Dashboard -> Team Settings -> Keys.
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Public HTTPS URL Plaid posts webhooks to (use a tunnel in dev).
PLAID_WEBHOOK_URL=

# --- Encryption for Plaid access tokens at rest ---
# Generate: openssl rand -base64 32
ENCRYPTION_KEY=

// Prisma schema — fin-dashboard. Postgres (Supabase).
// Tables use snake_case via @@map; `Profile.id` mirrors Supabase auth.users.id.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase transaction pooler, :6543) for app queries.
  url       = env("DATABASE_URL")
  // Direct connection (:5432) for migrations — the pooler can't run DDL.
  directUrl = env("DIRECT_URL")
}

enum ItemStatus {
  good
  login_required
  error
}

/// One row per authenticated user (Supabase owns identity in auth.users).
model Profile {
  id              String           @id @db.Uuid
  email           String?
  createdAt       DateTime         @default(now()) @map("created_at")
  items           PlaidItem[]
  dashboardConfig DashboardConfig?
  manualAssets    ManualAsset[]
  budgets         Budget[]
  goals           Goal[]

  @@map("profiles")
}

/// A connected financial institution (Plaid Item). Holds the encrypted token.
model PlaidItem {
  id                    String     @id @default(uuid()) @db.Uuid
  userId                String     @map("user_id") @db.Uuid
  user                  Profile    @relation(fields: [userId], references: [id], onDelete: Cascade)
  plaidItemId           String     @unique @map("plaid_item_id")
  accessTokenCiphertext String     @map("access_token_ciphertext")
  institutionId         String?    @map("institution_id")
  institutionName       String?    @map("institution_name")
  status                ItemStatus @default(good)
  transactionsCursor    String?    @map("transactions_cursor")
  lastSyncedAt          DateTime?  @map("last_synced_at")
  createdAt             DateTime   @default(now()) @map("created_at")
  accounts              Account[]

  @@index([userId])
  @@map("plaid_items")
}

/// A financial account within an Item (checking, credit card, etc.).
model Account {
  id               String            @id @default(uuid()) @db.Uuid
  itemId           String            @map("item_id") @db.Uuid
  item             PlaidItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  plaidAccountId   String            @unique @map("plaid_account_id")
  name             String
  officialName     String?           @map("official_name")
  mask             String?
  type             String
  subtype          String?
  currentBalance   Decimal?          @map("current_balance") @db.Decimal(20, 4)
  availableBalance Decimal?          @map("available_balance") @db.Decimal(20, 4)
  currency         String?           @default("USD")
  isHidden         Boolean           @default(false) @map("is_hidden")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  transactions     Transaction[]
  snapshots        BalanceSnapshot[]
  holdings         Holding[]
  investmentTxns   InvestmentTransaction[]
  liability        Liability?
  recurringStreams RecurringStream[]
  goals            Goal[]

  @@index([itemId])
  @@map("accounts")
}

/// A transaction. `amount` follows Plaid's sign: positive = money OUT of account.
model Transaction {
  id                 String    @id @default(uuid()) @db.Uuid
  accountId          String    @map("account_id") @db.Uuid
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidTransactionId String    @unique @map("plaid_transaction_id")
  amount             Decimal   @db.Decimal(20, 4)
  currency           String?   @default("USD")
  date               DateTime  @db.Date
  authorizedDate     DateTime? @map("authorized_date") @db.Date
  name               String
  merchantName       String?   @map("merchant_name")
  pending            Boolean   @default(false)
  pfcPrimary         String?   @map("pfc_primary")
  pfcDetailed        String?   @map("pfc_detailed")
  paymentChannel     String?   @map("payment_channel")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  detail             TransactionDetail?
  splits             TransactionSplit[]

  @@index([accountId, date])
  @@map("transactions")
}

/// User edits to one transaction: note, category override, tags. 1:1, created
/// lazily on first edit. NEVER referenced by sync.service.ts's TransactionRecord
/// mapper — that's what makes it immune to being clobbered on every resync (the
/// upsert's `update` payload only ever contains keys mapPlaidTransaction returns).
model TransactionDetail {
  id               String      @id @default(uuid()) @db.Uuid
  transactionId    String      @unique @map("transaction_id") @db.Uuid
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  note             String?
  categoryOverride String?     @map("category_override") // Plaid personal_finance_category primary
  tags             String[]    @default([])
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@map("transaction_details")
}

/// One line of a user-split transaction. The parent Transaction.amount stays the
/// source of truth for the account total; splits' amounts must sum to it
/// (enforced in TransactionsService, not a DB constraint). Replaced wholesale on
/// every edit (delete all + recreate), same idiom as the Plaid sync services.
model TransactionSplit {
  id               String      @id @default(uuid()) @db.Uuid
  transactionId    String      @map("transaction_id") @db.Uuid
  transaction      Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  amount           Decimal     @db.Decimal(20, 4)
  categoryOverride String?     @map("category_override")
  note             String?
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  @@index([transactionId])
  @@map("transaction_splits")
}

/// Daily balance snapshot per account -> powers net-worth-over-time.
model BalanceSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  accountId String   @map("account_id") @db.Uuid
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  current   Decimal? @db.Decimal(20, 4)
  available Decimal? @db.Decimal(20, 4)

  @@unique([accountId, date])
  @@map("balance_snapshots")
}

/// Per-user dashboard preferences ("choose what to show").
model DashboardConfig {
  userId    String   @id @map("user_id") @db.Uuid
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  config    Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("dashboard_configs")
}

/// Raw webhook audit + idempotency.
model WebhookEvent {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String?  @map("item_id")
  webhookType String   @map("webhook_type")
  webhookCode String   @map("webhook_code")
  payload     Json
  receivedAt  DateTime @default(now()) @map("received_at")

  @@map("webhook_events")
}

/// A security (stock / ETF / fund / cash) referenced by holdings & investment
/// transactions. Public market data (ticker, name, price) — NOT user-scoped;
/// deduped across users by Plaid's `security_id`.
model Security {
  id               String                  @id @default(uuid()) @db.Uuid
  plaidSecurityId  String                  @unique @map("plaid_security_id")
  name             String?
  tickerSymbol     String?                 @map("ticker_symbol")
  type             String?
  closePrice       Decimal?                @map("close_price") @db.Decimal(20, 6)
  closePriceAsOf   DateTime?               @map("close_price_as_of") @db.Date
  currency         String?                 @default("USD")
  isCashEquivalent Boolean                 @default(false) @map("is_cash_equivalent")
  cusip            String?
  isin             String?
  updatedAt        DateTime                @updatedAt @map("updated_at")
  holdings         Holding[]
  investmentTxns   InvestmentTransaction[]

  @@map("securities")
}

/// A current position: how much of one security is held in one account. This is a
/// snapshot (replaced on each investments sync), so it's unique per (account, security).
model Holding {
  id                   String    @id @default(uuid()) @db.Uuid
  accountId            String    @map("account_id") @db.Uuid
  account              Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId           String    @map("security_id") @db.Uuid
  security             Security  @relation(fields: [securityId], references: [id], onDelete: Cascade)
  quantity             Decimal   @db.Decimal(28, 8)
  institutionPrice     Decimal?  @map("institution_price") @db.Decimal(20, 6)
  institutionPriceAsOf DateTime? @map("institution_price_as_of") @db.Date
  institutionValue     Decimal?  @map("institution_value") @db.Decimal(20, 4)
  costBasis            Decimal?  @map("cost_basis") @db.Decimal(20, 4)
  currency             String?   @default("USD")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([accountId, securityId])
  @@index([accountId])
  @@map("holdings")
}

/// An investment transaction (buy / sell / dividend / fee / transfer …).
/// `amount` follows Plaid's sign: positive = cash OUT of the account (e.g. a buy).
model InvestmentTransaction {
  id                           String    @id @default(uuid()) @db.Uuid
  accountId                    String    @map("account_id") @db.Uuid
  account                      Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  securityId                   String?   @map("security_id") @db.Uuid
  security                     Security? @relation(fields: [securityId], references: [id], onDelete: SetNull)
  plaidInvestmentTransactionId String    @unique @map("plaid_investment_transaction_id")
  type                         String
  subtype                      String?
  quantity                     Decimal?  @db.Decimal(28, 8)
  amount                       Decimal   @db.Decimal(20, 4)
  price                        Decimal?  @db.Decimal(20, 6)
  fees                         Decimal?  @db.Decimal(20, 4)
  date                         DateTime  @db.Date
  name                         String
  currency                     String?   @default("USD")
  createdAt                    DateTime  @default(now()) @map("created_at")
  updatedAt                    DateTime  @updatedAt @map("updated_at")

  @@index([accountId, date])
  @@map("investment_transactions")
}

/// Liability detail for one account (Plaid Liabilities product): APR, statement /
/// due dates, minimum payment. One row per liability account (credit / student /
/// mortgage). The outstanding balance itself lives on Account.currentBalance;
/// this holds the extra loan/card metadata. `kind`-specific extras that don't fit
/// the common columns (credit APR breakdown, loan name, maturity date …) go in
/// `details`. Replaced on each liabilities sync.
model Liability {
  id                     String    @id @default(uuid()) @db.Uuid
  accountId              String    @unique @map("account_id") @db.Uuid
  account                Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind                   String // credit | student | mortgage
  aprPercentage          Decimal?  @map("apr_percentage") @db.Decimal(10, 4)
  lastPaymentAmount      Decimal?  @map("last_payment_amount") @db.Decimal(20, 4)
  lastPaymentDate        DateTime? @map("last_payment_date") @db.Date
  lastStatementBalance   Decimal?  @map("last_statement_balance") @db.Decimal(20, 4)
  lastStatementIssueDate DateTime? @map("last_statement_issue_date") @db.Date
  minimumPaymentAmount   Decimal?  @map("minimum_payment_amount") @db.Decimal(20, 4)
  nextPaymentDueDate     DateTime? @map("next_payment_due_date") @db.Date
  isOverdue              Boolean?  @map("is_overdue")
  details                Json? // kind-specific extras (credit aprs, loan name, maturity date …)
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@index([accountId])
  @@map("liabilities")
}

/// A recurring transaction stream (Plaid Recurring Transactions): a detected
/// subscription / paycheck / bill. `direction` = inflow (money in) | outflow
/// (money out). Amounts are Plaid-positive magnitudes; use `direction` for sign.
/// The full set is replaced on each recurring sync (Plaid returns active and
/// inactive streams together).
model RecurringStream {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @map("account_id") @db.Uuid
  account           Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plaidStreamId     String    @unique @map("plaid_stream_id")
  direction         String // inflow | outflow
  description       String
  merchantName      String?   @map("merchant_name")
  category          String? // Plaid personal_finance_category primary
  frequency         String // WEEKLY | BIWEEKLY | SEMI_MONTHLY | MONTHLY | ANNUALLY | UNKNOWN
  status            String // MATURE | EARLY_DETECTION | TOMBSTONED | UNKNOWN
  isActive          Boolean   @map("is_active")
  firstDate         DateTime  @map("first_date") @db.Date
  lastDate          DateTime  @map("last_date") @db.Date
  predictedNextDate DateTime? @map("predicted_next_date") @db.Date
  averageAmount     Decimal?  @map("average_amount") @db.Decimal(20, 4)
  lastAmount        Decimal?  @map("last_amount") @db.Decimal(20, 4)
  currency          String?   @default("USD")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([accountId])
  @@map("recurring_streams")
}

/// A user-entered, off-platform net-worth item (real estate, vehicle, cash, crypto,
/// or a manually-tracked liability) — not synced from Plaid. Unlike Liability/
/// RecurringStream (which scope through Account -> PlaidItem), this is a top-level
/// row directly owned by the user, since it has no Plaid account to hang off of.
model ManualAsset {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  kind         String // asset | liability
  category     String // real_estate | vehicle | cash | crypto | other_asset | loan | credit_debt | other_liability
  currentValue Decimal  @map("current_value") @db.Decimal(20, 4)
  currency     String?  @default("USD")
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("manual_assets")
}

/// A recurring monthly spending limit for one Plaid personal-finance-category
/// primary value. Not per-month history — one row per (user, category); the
/// current month's actual spend is computed on read from Transaction via
/// AggregationsService.spendingByCategory(), never stored here.
model Budget {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  user         Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String // Plaid personal_finance_category primary (see PLAID_PRIMARY_CATEGORIES)
  monthlyLimit Decimal  @map("monthly_limit") @db.Decimal(20, 4)
  currency     String?  @default("USD")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([userId, category])
  @@map("budgets")
}

/// A savings target or debt-payoff goal. Progress is computed on read, never
/// stored: if `linkedAccountId` is set, current amount tracks that account's
/// live `currentBalance`; otherwise `currentAmountOverride` is a manually-bumped
/// number the user updates themselves (e.g. savings spread across several places
/// with no single account to link).
model Goal {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @map("user_id") @db.Uuid
  user                  Profile   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  kind                  String // savings | debt_payoff
  targetAmount          Decimal   @map("target_amount") @db.Decimal(20, 4)
  targetDate            DateTime? @map("target_date") @db.Date
  linkedAccountId       String?   @map("linked_account_id") @db.Uuid
  linkedAccount         Account?  @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  currentAmountOverride Decimal?  @map("current_amount_override") @db.Decimal(20, 4)
  notes                 String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@index([linkedAccountId])
  @@map("goals")
}

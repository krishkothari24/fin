{
  "name": "fin-dashboard",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant personal financial dashboard (Plaid + Supabase).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "api:dev": "pnpm --filter @fin/api start:dev",
    "api:build": "pnpm --filter @fin/shared build && pnpm --filter @fin/api build",
    "web:build": "pnpm --filter @fin/shared build && pnpm --filter @fin/web build"
  }
}
